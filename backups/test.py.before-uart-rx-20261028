@cocotb.test()
async def test_bounded_edge_timeout_releases_all_pins(dut):
    await initialize(dut)
    await write_word(dut, 0, 0x1001)
    await write_word(dut, 1, 0x420F)
    await write_word(dut, 2, 0x1401)
